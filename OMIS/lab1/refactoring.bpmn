    <bpmn:task id="a_t2" name="Задать разделы" />
    <bpmn:task id="a_t3" name="Выдать доступ соредактору" />
    <bpmn:intermediateCatchEvent id="a_e1" name="Новая версия сохранена">
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="a_t4" name="Просмотреть версию" />
