    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="s_t7" targetRef="s_end1" />
    <bpmn:sequenceFlow id="SequenceFlow_17" name="да" sourceRef="s_g1" targetRef="s_t8" />
    <bpmn:sequenceFlow id="SequenceFlow_18" sourceRef="s_t8" targetRef="s_end2" />
  </bpmn:process>
