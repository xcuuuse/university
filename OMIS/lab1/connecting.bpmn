<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_admin" name="Администратор рабочего пространства" processRef="Process_Pool_admin" />
    <bpmn:participant id="Pool_member" name="Участник" processRef="Process_Pool_member" />
    <bpmn:participant id="Pool_system" name="Система" processRef="Process_Pool_system" />
    <bpmn:messageFlow id="MessageFlow_1" name="Почта и роль" sourceRef="ad_t1" targetRef="s_start" />
    <bpmn:messageFlow id="MessageFlow_2" name="Приглашение" sourceRef="s_t3" targetRef="m_start" />
    <bpmn:messageFlow id="MessageFlow_3" name="Согласие" sourceRef="m_t1" targetRef="s_t4" />
    <bpmn:messageFlow id="MessageFlow_4" name="Уведомление" sourceRef="s_t5" targetRef="ad_e1" />
    <bpmn:messageFlow id="MessageFlow_5" name="Список документов" sourceRef="ad_t2" targetRef="s_t6" />
    <bpmn:messageFlow id="MessageFlow_6" name="Права доступа" sourceRef="s_t7" targetRef="m_e1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_admin" isExecutable="false">
    <bpmn:startEvent id="ad_start" name="Нужен новый участник" />
    <bpmn:task id="ad_t1" name="Ввести почту и роль" />
    <bpmn:intermediateCatchEvent id="ad_e1" name="Участник подключился">
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="ad_t2" name="Отметить документы и уровень доступа" />
    <bpmn:endEvent id="ad_end" name="Доступ настроен" />
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="ad_start" targetRef="ad_t1" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ad_t1" targetRef="ad_e1" />
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ad_e1" targetRef="ad_t2" />
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="ad_t2" targetRef="ad_end" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_member" isExecutable="false">
    <bpmn:startEvent id="m_start" name="Приглашение получено">
      <bpmn:messageEventDefinition id="MessageEventDefinition_2" />
    </bpmn:startEvent>
    <bpmn:task id="m_t1" name="Принять приглашение" />
    <bpmn:intermediateCatchEvent id="m_e1" name="Доступ выдан">
      <bpmn:messageEventDefinition id="MessageEventDefinition_3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="m_end" name="Работа возможна" />
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="m_start" targetRef="m_t1" />
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="m_t1" targetRef="m_e1" />
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="m_e1" targetRef="m_end" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_system" isExecutable="false">
    <bpmn:startEvent id="s_start" name="Поступили данные участника">
      <bpmn:messageEventDefinition id="MessageEventDefinition_4" />
    </bpmn:startEvent>
    <bpmn:task id="s_t1" name="Проверить наличие участника" />
    <bpmn:exclusiveGateway id="s_g1" name="Участник уже есть?" />
    <bpmn:task id="s_t2" name="Создать участника" />
    <bpmn:task id="s_t3" name="Отправить приглашение" />
    <bpmn:task id="s_t4" name="Перевести в статус «активен»" />
    <bpmn:task id="s_t5" name="Уведомить администратора" />
    <bpmn:task id="s_t6" name="Сохранить права доступа" />
    <bpmn:task id="s_t7" name="Уведомить участника" />
    <bpmn:endEvent id="s_end1" name="Участник подключён" />
    <bpmn:task id="s_t8" name="Сообщить об ошибке" />
    <bpmn:endEvent id="s_end2" name="Приглашение отклонено" />
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="s_start" targetRef="s_t1" />
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="s_t1" targetRef="s_g1" />
    <bpmn:sequenceFlow id="SequenceFlow_10" name="нет" sourceRef="s_g1" targetRef="s_t2" />
