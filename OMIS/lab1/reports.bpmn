    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="a_t5" targetRef="a_end2" />
    <bpmn:task id="a_t5" name="Отклонить правку" />
    <bpmn:endEvent id="a_end2" name="Правка отклонена" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_reviewer" isExecutable="false">
    <bpmn:intermediateCatchEvent id="r_e1" name="Результат рассмотрения">
      <bpmn:messageEventDefinition id="MessageEventDefinition_3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="r_end" name="Рецензирование завершено" />
