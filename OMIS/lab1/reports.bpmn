    <bpmn:participant id="Pool_system" name="Система" processRef="Process_Pool_system" />
    <bpmn:messageFlow id="MessageFlow_1" name="Документ" sourceRef="a_t1" targetRef="s_start" />
    <bpmn:messageFlow id="MessageFlow_2" name="Уведомление" sourceRef="s_t2" targetRef="r_start" />
