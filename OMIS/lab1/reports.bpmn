    <bpmn:task id="a_t3" name="Принять правку" />
    <bpmn:task id="a_t4" name="Опубликовать документ" />
    <bpmn:endEvent id="a_end1" name="Документ опубликован" />
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="a_start" targetRef="a_t1" />
