    <bpmn:intermediateCatchEvent id="a_e1" name="Поступила правка">
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="a_t2" name="Просмотреть правку" />
