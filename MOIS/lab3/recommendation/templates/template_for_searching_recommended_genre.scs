@search_recommended_genre_template= {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._recommendation_system <-_ concept_recommendation_system);;
            rrel_user _-> (.._recommendation_system _-> .._user);;
            @output_param1 = (.._user <-_ concept_user);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *);
    rrel_next_template: {
        rrel_init_template: {
            rrel_template: [*
                @input_param1 = (.._user <-_ concept_user);;
                rrel_recommended_genre _-> (.._user _-> .._recommended_genre);;
                @output_param1 = (.._recommended_genre <-_ concept_genre);;
            *];
            rrel_template_input_params: {
                @input_param1
            };
            rrel_template_output_params: {
                @output_param1
            }
        } (* <- nrel_search_set_template;; *);
        rrel_next_template: {
            rrel_init_template: {
                rrel_template: [*
                    @input_param1 = (.._recommended_genre <-_ concept_genre);;
                    nrel_genre_name _-> (.._recommended_genre _=> .._genre_name);;
                    @output_param1 = (.._genre_name <-_ lang_ru);;
                *];
                rrel_template_input_params: {
                    @input_param1
                };
                rrel_template_output_params: {
                    @output_param1
                }
            } (* <- nrel_search_template;; *)
        } (* <- nrel_fixed_search_strategy_template;; *)
    } (* <- nrel_fixed_search_strategy_template;; *)
};;

@search_recommended_genre_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска рекомендуемых пользователю жанров]
    (*
        <- lang_ru;;
    *);;
  