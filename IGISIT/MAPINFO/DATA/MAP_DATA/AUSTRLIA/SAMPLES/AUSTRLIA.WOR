!Workspace
!Version 400
!Charset WindowsLatin1
Open Table "ausmajrd" As Ausmajrd Interactive
Open Table "ausmajrv" As Ausmajrv Interactive
Open Table "austrlia" As Austrlia Interactive
Open Table "auscity" As Auscity
Browse * From Austrlia
  Position (0.0416667,0.015) Units "in"
  Width 1.6875 Units "in" Height 1.88542 Units "in" 
Browse * From Auscity
  Position (0.0416667,2.1875) Units "in"
  Width 1.6875 Units "in" Height 1.88542 Units "in" 
Map From Auscity,Ausmajrv,Ausmajrd,Austrlia 
  Position (1.82292,0.015) Units "in"
  Width 4.75 Units "in" Height 4.067705 Units "in" 
Set Window FrontWindow() ScrollBars Off Autoscroll On
Set Map
  CoordSys Earth Projection 1, 0
  Center (135.6,-27)
  Zoom 5000 Units "km"
  Preserve Zoom Display Zoom
  XY Units "degree" Distance Units "km" Area Units "sq km"
Set Map
  Layer 1
    Display Graphic
    Label Line Arrow Position Right Font ("Arial",1,9,0) Pen (1,2,0) 
      With City
      Parallel On Auto On Overlap Off Duplicates On Offset 10
      Visibility On
   Object 3  Position Below Right Offset 5 
   Object 6  Position Below Left Offset 5 
   Object 5  Position Below Right Offset 5 
   Object 1  Position Left 
   Object 4  Position Left 
   Object 7  Position Left 
  Layer 2
    Display Graphic
    Label Line Arrow Position Above Font ("Arial",0,8,255) Pen (1,2,0) 
      With River
      Parallel On Auto On Overlap Off Duplicates Off Offset 2
      Visibility Zoom (0, 500) Units "km"
  Layer 3
    Display Global
    Global    Line (1,65,16776960)  
    Label Line Arrow Position Above Font ("Arial",0,8,0) Pen (1,2,0) 
      With Street
      Parallel On Auto On Overlap Off Duplicates Off Offset 2
      Visibility Zoom (0, 1000) Units "km"
  Layer 4
    Display Graphic
    Label Line None Position Center Font ("Arial",0,9,0) Pen (1,2,0) 
      With State
      Parallel On Auto Off Overlap Off Duplicates On Offset 2
      Visibility On
