!Workspace
!Version 1200
!Charset WindowsCyrillic
Open Table "MAPINFO\DATA\TUT_DATA\TUT_USA\USA\STATES" As STATES Interactive
Open Table "MAPINFO\DATA\TUT_DATA\TUT_USA\USA\US_HIWAY" As US_HIWAY Interactive
Open Table "MAPINFO\DATA\TUT_DATA\TUT_USA\USA\STATECAP" As STATECAP Interactive
Open Table "MAPINFO\DATA\TUT_DATA\TUT_USA\USA\US_CUSTG" As US_CUSTG Interactive
Open Table "MAPINFO\DATA\TUT_DATA\TUT_USA\USA\US_ZIPS" As US_ZIPS Interactive
Select STATES . State_Name , US_HIWAY . Highway  from STATES , US_HIWAY  where STATES . obj intersects US_HIWAY . obj and STATES . State_Name = "Oregon"  into Query3 noselect  order by US_HIWAY . Highway  
Select STATES . State_Name , US_HIWAY . Highway  from STATES , US_HIWAY  where STATES . obj intersects US_HIWAY . obj and STATES . State_Name = "Oregon"  into Query4 noselect  order by US_HIWAY . Highway  
Select *  from STATES  where Total_Area > 50000  into Query5 noselect  
Select sum ( Sales_1990 )  from STATES  into Query1 noselect  
Map From STATES
  Position (0.0583333,1.75) Units "in"
  Width 7.95833 Units "in" Height 3.5 Units "in" 
Set Window FrontWindow() ScrollBars Off Autoscroll On Enhanced On Smooth Text Antialias Image High
Set Map
  CoordSys Earth Projection 1, 62
  Center (-121.2353381,55.05630022)
  Zoom 5330.926329 Units "km"
  Preserve Zoom Display Zoom
  Distance Units "km" Area Units "sq km" XY Units "degree"
Set Map
  Layer 1
    Display Graphic
    Global Pen (1,2,0) Brush (2,16777215,16777215) Symbol (35,0,12) Line (1,2,0) Font ("Tahoma",0,9,0)
    Label Line None Position Center Font ("Tahoma",0,9,0) Pen (1,2,0) 
      With State_Name
      Parallel On Auto Off Overlap Off Duplicates On Offset 2
      Visibility On
Set Map Label Selection Off 
Set Window FrontWindow() Printer
 Name "MapInfo PDF Printer Version 2023" Orientation Portrait Copies 1
 Papersize 9
