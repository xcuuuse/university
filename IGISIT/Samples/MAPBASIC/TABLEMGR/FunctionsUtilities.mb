Include "TableManager.def"
'****************************************************************************
' Sub procedure: InitValidFunctions
'****************************************************************************
Sub InitValidFunctions

  OnError Goto HandleError

  gaValidFunctions(1) = ";" 
  gaValidFunctions(2) = "CurDate() YYYYMMDD;" 
  gaValidFunctions(3) = "CurDate() & Time() YYYYMMDD HHMMSSSS;" 
  gaValidFunctions(4) = "Time() HHMMSSSS;" 
  gaValidFunctions(5) = "NumberOfPointObjectsInTable();" 
  gaValidFunctions(6) = "NumberOfRegionObjectsInTable();" 
  gaValidFunctions(7) = "NumberOfLineObjectsInTable();" 
  gaValidFunctions(8) = "NumberOfPolyLineObjectsInTable();" 
  gaValidFunctions(9) = "TableInfo(TAB_INFO_NAME);" 
  gaValidFunctions(10) = "TableInfo(TAB_INFO_TYPE);" 
  gaValidFunctions(11) = "TableInfo(TAB_INFO_NCOLS);" 
  gaValidFunctions(12) = "TableInfo(TAB_INFO_MAPPABLE);" 
  gaValidFunctions(13) = "TableInfo(TAB_INFO_READONLY);" 
  gaValidFunctions(14) = "TableInfo(TAB_INFO_NROWS);" 
  gaValidFunctions(15) = "TableInfo(TAB_INFO_MAPPABLE_TABLE);" 
  gaValidFunctions(16) = "TableInfo(TAB_INFO_TABFILE);"  
  gaValidFunctions(17) = "TableInfo(TAB_INFO_MINX);" 
  gaValidFunctions(18) = "TableInfo(TAB_INFO_MINY);" 
  gaValidFunctions(19) = "TableInfo(TAB_INFO_MAXX);" 
  gaValidFunctions(20) = "TableInfo(TAB_INFO_MAXY);" 
  gaValidFunctions(21) = "TableInfo(TAB_INFO_SEAMLESS);" 
  gaValidFunctions(22) = "TableInfo(TAB_INFO_COORDSYS_MINX);" 
  gaValidFunctions(23) = "TableInfo(TAB_INFO_COORDSYS_MINY);" 
  gaValidFunctions(24) = "TableInfo(TAB_INFO_COORDSYS_MAXX);" 
  gaValidFunctions(25) = "TableInfo(TAB_INFO_COORDSYS_MAXY);" 
  gaValidFunctions(26) = "TableInfo(TAB_INFO_COORDSYS_CLAUSE);" 
  gaValidFunctions(MAX_VALID_FUNCTIONS) = "TableInfo(TAB_INFO_COORDSYS_NAME);"

  Exit Sub

HandleError:
  Note "InitValidFunctions: " + Error$()
  Resume Next

End Sub
'****************************************************************************
' Sub procedure: AppendFunction
'****************************************************************************
Sub AppendFunction

  OnError Goto HandleError

  Dim sValue, sFunctionReturn As String
  Dim iFunction, iCntSelection, iTabType As Integer

  sValue = ReadControlValue(TB_VALUE)

  iFunction = ReadControlValue(PUM_FUNCTIONS)
  sFunctionReturn = PerformFunction(iFunction)

  If sFunctionReturn <> "" Then
    If sValue <> GetResString(IDS_EMPTY) Then
      sValue = sValue + sFunctionReturn
    Else
      sValue = sFunctionReturn
    End If

    Alter Control TB_VALUE
      Value sValue
  End If

  Exit Sub

HandleError:
  If Err() = 644 Or Err() = 414 Then
    sFunctionReturn = GetResString(IDS_UNDEFINED)
    Resume Next
  Else
    Note "AppendFunction: " + Error$() + " #" + Err()
    Resume Next
  End If

End Sub
'****************************************************************************
' Function: PerformFunction
'****************************************************************************
Function PerformFunction(iFunctions As Integer) As String

  OnError Goto HandleError

  Dim sFunctionReturn As String
  Dim iCntSelection, iTabType As Integer

  Do Case iFunctions
    Case 1                   ' ;" 
        sFunctionReturn = ""
    Case 2                   ' CurrentDate();" 
        sFunctionReturn = curdate()
    Case 3                   ' CurrentData & Time();" 
        sFunctionReturn = curdate() + " " + Left$(Time(24),2) + Mid$(Time(24), 4, 2) + Right$(Time(24),2) + "00"
    Case 4                   ' Current Time();" 
        sFunctionReturn = Left$(Time(24),2) + Mid$(Time(24), 4, 2) + Right$(Time(24),2) + "00"
    Case 5                   ' NumberPointObjectsInTable();" 
      If gsCurTable <> "" Then
        If TableInfo(gsCurTable, TAB_INFO_TYPE) = TAB_TYPE_IMAGE Or TableInfo(gsCurTable, TAB_INFO_MAPPABLE) = FALSE then
          sFunctionReturn = GetResString(IDS_NOT_APPLICABLE)
        Else
          Select * From gsCurTable where str$(obj) = "Point" into PtsInTab
          iCntSelection = TableInfo(PtsInTab, TAB_INFO_NROWS)
          Close Table PtsInTab
          sFunctionReturn = iCntSelection
        End If
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 6                   ' NumberRegionObjectsInTable();" 
      If gsCurTable <> "" Then
        If TableInfo(gsCurTable, TAB_INFO_TYPE) = TAB_TYPE_IMAGE Or TableInfo(gsCurTable, TAB_INFO_MAPPABLE) = FALSE then
            sFunctionReturn = GetResString(IDS_NOT_APPLICABLE)
        Else
            Select * From gsCurTable where str$(obj) = "Region" into RegInTab
            iCntSelection = TableInfo(RegInTab, TAB_INFO_NROWS)
            Close Table RegInTab
            sFunctionReturn = iCntSelection 
        End If
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 7                   ' NumberLineObjectsInTable();" 
      If gsCurTable <> "" Then
        If TableInfo(gsCurTable, TAB_INFO_TYPE) = TAB_TYPE_IMAGE Or TableInfo(gsCurTable, TAB_INFO_MAPPABLE) = FALSE then
            sFunctionReturn = GetResString(IDS_NOT_APPLICABLE)
        Else
            Select * From gsCurTable where str$(obj) = "Line" into LinInTab
            iCntSelection = TableInfo(LinInTab, TAB_INFO_NROWS)
            Close Table LinInTab
            sFunctionReturn = iCntSelection 
        End If
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 8                   ' NumberPolyLineObjectsInTable();" 
      If gsCurTable <> "" Then
        If TableInfo(gsCurTable, TAB_INFO_TYPE) = TAB_TYPE_IMAGE Or TableInfo(gsCurTable, TAB_INFO_MAPPABLE) = FALSE then
            sFunctionReturn = GetResString(IDS_NOT_APPLICABLE)
        Else
            Select * From gsCurTable where str$(obj) = "Polyline" into PlnInTab
            iCntSelection = TableInfo(PlnInTab, TAB_INFO_NROWS)
            Close Table PlnInTab
            sFunctionReturn = iCntSelection 
        End If
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 9                   ' TableInfo(TAB_INFO_NAME);" 
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable, TAB_INFO_NAME)
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 10                 ' TableInfo(TAB_INFO_TYPE);" 
      If gsCurTable <> "" Then
        iTabType = TableInfo(gsCurTable, TAB_INFO_TYPE)
        Do Case iTabType
            Case 1
                sFunctionReturn = "TAB_TYPE_BASE"
            Case 2
                sFunctionReturn = "TAB_TYPE_RESULT"
            Case 3
                sFunctionReturn = "TAB_TYPE_VIEW"
            Case 4
                sFunctionReturn = "TAB_TYPE_IMAGE"
            Case 5
                sFunctionReturn = "TAB_TYPE_LINKED"
        End Case
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 11                   ' TableInfo(TAB_INFO_NCOLS);" 
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable,TAB_INFO_NCOLS) 
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 12                   ' TableInfo(TAB_INFO_MAPPABLE);" 
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable,TAB_INFO_MAPPABLE)
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 13                   ' TableInfo(TAB_INFO_READONLY);" 
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable,TAB_INFO_READONLY)
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 14                   ' TableInfo(TAB_INFO_NROWS);" 
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable,TAB_INFO_NROWS)
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 15                   ' TableInfo(TAB_INFO_MAPPABLE_TABLE);" 
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable,TAB_INFO_MAPPABLE_TABLE)
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 16                   ' TableInfo(TAB_INFO_TABFILE);"  
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable,TAB_INFO_TABFILE)
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 17                   ' TableInfo(TAB_INFO_MINX);" 
      If gsCurTable <> "" Then
        sFunctionReturn = Format$(TableInfo(gsCurTable,TAB_INFO_MINX),"#.######")
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 18                   ' TableInfo(TAB_INFO_MINY);" 
      If gsCurTable <> "" Then
        sFunctionReturn = Format$(TableInfo(gsCurTable,TAB_INFO_MINY),"#.######")
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 19                   ' TableInfo(TAB_INFO_MAXX);" 
      If gsCurTable <> "" Then
        sFunctionReturn = Format$(TableInfo(gsCurTable,TAB_INFO_MAXX),"#.######")
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 20                   ' TableInfo(TAB_INFO_MAXY);" 
      If gsCurTable <> "" Then
        sFunctionReturn = Format$(TableInfo(gsCurTable,TAB_INFO_MAXY),"#.######")
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 21                   ' TableInfo(TAB_INFO_SEAMLESS);" 
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable,TAB_INFO_SEAMLESS)
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 22                   ' TableInfo(TAB_INFO_COORDSYS_MINX);" 
      If gsCurTable <> "" Then
        sFunctionReturn = Format$(TableInfo(gsCurTable,TAB_INFO_COORDSYS_MINX),"#.######")
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 23                   ' TableInfo(TAB_INFO_COORDSYS_MINY);" 
      If gsCurTable <> "" Then
        sFunctionReturn = Format$(TableInfo(gsCurTable,TAB_INFO_COORDSYS_MINY),"#.######")
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 24                   ' TableInfo(TAB_INFO_COORDSYS_MAXX);" 
      If gsCurTable <> "" Then
        sFunctionReturn = Format$(TableInfo(gsCurTable,TAB_INFO_COORDSYS_MAXX),"#.######")
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 25                   ' TableInfo(TAB_INFO_COORDSYS_MAXY);" 
      If gsCurTable <> "" Then
        sFunctionReturn = Format$(TableInfo(gsCurTable,TAB_INFO_COORDSYS_MAXY),"#.######")
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 26                   ' TableInfo(TAB_INFO_COORDSYS_CLAUSE);" 
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable,TAB_INFO_COORDSYS_CLAUSE)
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
    Case 27                   ' TableInfo(TAB_INFO_COORDSYS_NAME);"
      If gsCurTable <> "" Then
        sFunctionReturn = TableInfo(gsCurTable,TAB_INFO_COORDSYS_NAME)
      Else
        sFunctionReturn = GetResString(IDS_EMPTY)
      End If
  End Case

  PerformFunction = sFunctionReturn

  Exit Function

HandleError:
  If Err() = 644 Or Err() = 414 Then
    sFunctionReturn = GetResString(IDS_UNDEFINED)
    Resume Next
  Else
    Note "PerformFunction: " + Error$() + " #" + Err()
    Resume Next
  End If

End Function
