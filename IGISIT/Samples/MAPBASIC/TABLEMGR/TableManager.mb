'****************************************************************************
' Sub procedure: ExitTableManager
'****************************************************************************
Sub ExitTableManager

  OnError Goto HandleError

  End Program

  Exit Sub

HandleError:
  Note "ExitTableManager: " + Error$()
  Resume Next

End Sub

