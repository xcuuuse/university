Include "TableManager.def"
'****************************************************************************
' Sub procedure: ReadTableInfo
'****************************************************************************
Sub ReadTableInfo(sTableName As String, iVersion As Integer, sType As String, sFile As String)

  OnError Goto HandleError

  Dim sFileName, sLine As String
  Dim lContinue As Logical
  Dim i As Integer

  sFileName = TableInfo(sTableName, TAB_INFO_TABFILE)

  If sFileName <> "" Then

    Open File sFileName For Input As #3

'Print "Reading " + sFileName

    iVersion = 0
    sType = ""
    sFile = ""

    lContinue = TRUE
    Line Input #3, sLine

    While lContinue

'Print "  Checking " + sLine

      If iVersion = 0 Then
        i = InStr(1, UCase$(sLine), "VERSION")
        If i > 0 Then
          iVersion = Val(Mid$(sLine, i+8, 80))
'Print "    Found version = " + iVersion
        End If
      End If

      If sType = "" Then
        i = InStr(1, UCase$(sLine), "TYPE")
        If i > 0 Then
          sType = Mid$(sLine, i+5, 80)
          i = InStr(1, sType, " ")
          If i > 0 Then
            sType = Left$(sType, i-1)
          End If
          i = InStr(1, sType, """")
          Do While i > 0
            sType = Left$(sType, i-1) + Mid$(sType, i+1, 80)
            i = InStr(1, sType, """")
          Loop
'Print "    Found type = " + sType
        End If
      End If

      If sFile = "" Then
        i = InStr(1, UCase$(sLine), "FILE")
        If i > 0 Then
          sFile = Mid$(sLine, i+5, 80)
          i = InStr(1, sFile, " ")
          If i > 0 Then
            sFile = Left$(sFile, i-1)
          End If
          If sFile = """" Then
            sFile = ""
          End If
'Print "    Found file = " + sFile
        End If
      End If

      Line Input #3, sLine

      If EOF(3) Then
        lContinue = FALSE
      End If

    Wend

    Close File #3

  End If

  Exit Sub

HandleError:
  Note "ReadTableInfo: " + Error$()
  Resume Next

End Sub
