Include "Win32API.def"

Define LF					CHR$(13)
Define MAX_PATH 			 260

'*********************************
'Define the basic global variables
'*********************************

Global gstrAppTitle 	As String	'Long description of application name
Global tCurrTime	 AS tSystemTime
Global sCopyright   		As String
Global sCopyrightFilename  As String
Global bImportCopyright 	As Logical
Global gstrINIFile  		As String

Global gstrVersion  		As String
Global gstrBuild			As String

'-----------------------------
' Local routines
'-----------------------------
Declare Sub OKBtnHndlr1
Declare Sub RadioBtnHndlr
Declare Sub DlgHndlr
Declare sub PlaceNameRdio_Hndlr
Declare Sub selectExportModeDlgHndlr
Declare Sub ExportModeChkHndlr
Declare Sub exportImageDlgHndlr
Declare Sub exportImageDlgControlsHndlr
'-------------------------------------------------------------------------------------------------------------------------------
'------SYSTEM ROUTINES----------------------------------------------------------------------------------------------------------
'-------------------------------------------------------------------------------------------------------------------------------

Sub Initialise
	Dim   strMyDocs, 	   'What is sent to API funct.
		 strStyle,
		 strDefault  As String	'Default value supplied

	Dim   nRetVal	 As Integer  'Value returned from function that reads INI
	Dim   nPos,nPos2  As Smallint 'General LOOP counter
	Dim   bFound 	 AS LOGICAL
	
	Dim   bFoundValue as Logical

	'Setup error handler
	strDefault = "Empty"
	OnError GOTO ErrorHandler
	
	'***************************************************************************
	'SET GLOBAL VARIABLES
	'***************************************************************************

	'------------------------------------------------------------------------*
	'   As of 6/2007, the build number is independant of any MIPro build.  
	'   It should be incremented whenever there is a release of GELink.
	'   (MIPro release, slipstream release, etc.)
	'-------------------------------------------------------------------------*
	gstrVersion = "2.0 "
	gstrBuild = "1 "

	gstrAppName	= GetResString(IDS_APP_NAME)
	gstrAppTitle  = GetResString(IDS_APP_TITLE) '	"Google Earth Link"
	gstrINIFile	= GetFolderPath$( FOLDER_MI_PREFERENCE ) + gstrAppName + ".INI"
	
	gbExtrude = TRUE
	gnHMode = HeightMode_ClampToGround
	gnHVal  = 5
	gnhField = 1
	gnhField_NumericsOnly = 1
	
	gPlacenameMode = 1
	gbAllowRunGE = TRUE
	
	sCopyright = GetResString(IDS_DEFAULT_COPYRIGHT) ' "Exported from MapInfo"
	sCopyrightFilename = ""
	bImportCopyright = FALSE
	
	gbAllowRunGE = CheckForGoogleEarth()
	gbRunGENow = gbAllowRunGE
	gSelCntr = 0
	
	' Handle case when no map window open
	OnError goto NoMapWinOpen
	 ' This fixes a startup focus problem
	iLastWinType=WindowInfo(CommandInfo(CMD_INFO_WIN),WIN_INFO_TYPE)
	
	OnError GOTO ErrorHandler
	
	'--------------------------------------------------
	' READ IN INI FILE SETTINGS
	'--------------------------------------------------
	strMyDocs = string$(512, " ")
	
	OnError goto ErrorHandler
	
	' Ini file will live in preferences dir
	Dim strContents as string
	Dim Default as string
	Dim RetVal As Integer
	strContents = string$(INI_TOKEN_CONTENT_SIZE, " ")
	strDefault = string$(INI_TOKEN_CONTENT_SIZE, " ")
	strDefault = GetFolderPath$( FOLDER_MI_PREFERENCE )

	If FileExists(gstrINIFile) Then
		
		nRetVal = GetINIString32Wrapper("Settings","OutputPath", strDefault, strContents, 128, gstrINIFile)

		If strContents <> "" Then
			gstrOutputPath = strContents
		Else
			gstrOutputPath = GetFolderPath$( FOLDER_MI_PREFERENCE )
		End If

	Else
		' Default Output Path is user's 'My Documents'
		Dim	nCreate,
			hwnd,
			id 	as Integer

		nCreate = 0
		hwnd = 0
		id = CSIDL_PERSONAL
	
		OnError goto MyDocsError
		bFoundValue = SHGetSpecialFolderPath ( hwnd, strMyDocs, id, nCreate )
	
		If Not bFoundValue Then
			strMyDocs = APPLICATIONDIRECTORY$()
		End If
		gstrOutputPath = strMyDocs
	End If

	OnError goto ErrorHandler

	' Check for trailing '\' on path.
	If "\" <>  Mid$(gstrOutputPath, Len(gstrOutputPath), 1) then
		gstrOutputPath = gstrOutputPath + "\"
	End If

	Goto goodXit

NoMapWinOpen:
	Resume Next

ErrorHandler:
	gstrMsg = GetResString(IDS_WARNING_BANG) + CHR$(13)+CHR$(13)
	gstrMsg = gstrMsg + GetResString(IDS_ERROR_READING_INI) + " "
	gstrMsg = gstrMsg + GetResString(IDS_APP_NAME) + "."
	gstrMsg = gstrMsg + Chr$(13) + Error$()
	Goto Xit

RegError:
	gstrMsg = GetResString(IDS_CANT_FIND_GE) + CHR$(13)+CHR$(13)
	note gstrMsg
	gbAllowRunGE = FALSE
	gbRunGENow = FALSE
	Resume Next

MyDocsError:
	Note "Error finding My Documents folder"
	Resume Next

Xit:
	Note gstrMsg

goodXit:

End Sub 'Initalise


